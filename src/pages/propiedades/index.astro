---
import Layout from '../../layouts/Layout.astro';
import PropertySkeleton from '../../components/PropertySkeleton.astro';
import type { PropertyType } from '../../lib/properties';

// Los mismos botones de tipo que el sitio anterior.
const types: { value: PropertyType; label: string; aria: string }[] = [
  { value: 'casa', label: 'Casa', aria: 'Casas' },
  { value: 'chalet', label: 'Chalet', aria: 'Chalets' },
  { value: 'galpon', label: 'Galpón', aria: 'Galpones' },
  { value: 'local', label: 'Local', aria: 'Locales' },
  { value: 'lote', label: 'Lote', aria: 'Lotes' },
  { value: 'departamento', label: 'Depto.', aria: 'Departamentos' },
  { value: 'duplex', label: 'Dúplex', aria: 'Dúplex' },
];
---

<Layout
  title="Propiedades | Rizzo Propiedades — Lanús, GBA"
  description="Todas las propiedades en venta y alquiler de Rizzo Propiedades. Casas, locales, galpones y terrenos en Lanús, Avellaneda, Banfield y zona sur GBA."
  active="propiedades"
  preloadImage="/img/hero.jpg"
>
  <div class="page-hero-banner">
    <img src="/img/hero.jpg" alt="Propiedades en Lanús y Gran Buenos Aires" fetchpriority="high" loading="eager" />
    <div class="page-hero-banner-overlay" aria-hidden="true"></div>
    <div class="page-hero-banner-content">
      <p class="page-hero-banner-eyebrow">Rizzo Propiedades</p>
      <h1 class="page-hero-banner-title">Nuestras Propiedades</h1>
    </div>
  </div>

  <div class="props-filter-bar" role="search" aria-label="Filtrar propiedades">
    <div class="props-filter-inner">
      <div class="filter-row">
        <div class="filter-group">
          <span class="filter-label">Operación:</span>
          <button class="filter-btn is-active" data-filter="todos" data-filter-group="op" aria-label="Ver todas las operaciones">Todos</button>
          <button class="filter-btn" data-filter="venta" data-filter-group="op" aria-label="Filtrar por venta">Venta</button>
          <button class="filter-btn" data-filter="alquiler" data-filter-group="op" aria-label="Filtrar por alquiler">Alquiler</button>
        </div>
        <div class="filter-group">
          <span class="filter-label">Tipo:</span>
          <button class="filter-btn is-active" data-filter="todos" data-filter-group="tipo" aria-label="Ver todos los tipos">Todos</button>
          {
            types.map((t) => (
              <button class="filter-btn" data-filter={t.value} data-filter-group="tipo" aria-label={t.aria}>
                {t.label}
              </button>
            ))
          }
        </div>
      </div>
      <div class="filter-row filter-row--advanced">
        <div class="filter-group">
          <label class="filter-label" for="filter-zona">Localidad:</label>
          <select class="filter-select" id="filter-zona" aria-label="Filtrar por localidad">
            <option value="">Todas</option>
          </select>
        </div>
      </div>
      <div class="filter-row filter-row--advanced">
        <div class="filter-group">
          <label class="filter-label" for="filter-ambientes">Ambientes:</label>
          <select class="filter-select" id="filter-ambientes" aria-label="Filtrar por ambientes">
            <option value="0">Todos</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5+</option>
          </select>
        </div>
        <div class="filter-group">
          <label class="filter-label" for="filter-banios">Baños:</label>
          <select class="filter-select" id="filter-banios" aria-label="Filtrar por baños">
            <option value="0">Todos</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3+</option>
          </select>
        </div>
        <div class="filter-group">
          <button class="filter-btn" id="filter-cochera" aria-pressed="false" aria-label="Solo propiedades con cochera">Cochera</button>
        </div>
        <div class="filter-group">
          <button class="filter-btn" id="filter-credito" aria-pressed="false" aria-label="Solo propiedades aptas para crédito">Apto crédito</button>
        </div>
        <div class="filter-group filter-group--price">
          <span class="filter-label">Precio:</span>
          <select class="filter-select" id="filter-moneda" aria-label="Moneda del precio">
            <option value="">Todas</option>
            <option value="USD">USD</option>
            <option value="ARS">ARS</option>
          </select>
          <input class="filter-input" id="filter-precio-min" type="number" min="0" step="1000" placeholder="Mín" aria-label="Precio mínimo (elegí una moneda)" title="Elegí una moneda para filtrar por precio" disabled />
          <span class="filter-price-sep">–</span>
          <input class="filter-input" id="filter-precio-max" type="number" min="0" step="1000" placeholder="Máx" aria-label="Precio máximo (elegí una moneda)" title="Elegí una moneda para filtrar por precio" disabled />
        </div>
        <span class="filter-count" aria-live="polite" aria-atomic="true">Cargando…</span>
      </div>
    </div>
  </div>

  <section class="props-page" aria-labelledby="props-page-title">
    <div class="container">
      <h2 class="sr-only" id="props-page-title">Listado de propiedades</h2>
      <!-- Se completa en el navegador con las propiedades de property-service. -->
      <div class="props-page-grid" data-props-grid>
        <PropertySkeleton count={6} />
      </div>
      <p class="props-empty" data-props-status>Cargando propiedades…</p>
      <p class="props-empty" data-filter-empty hidden>
        No hay propiedades con esos filtros.
        <button type="button" class="link-button" data-filter-clear>Limpiar filtros</button>
      </p>
      <noscript>
        <p class="props-empty">
          Para ver las propiedades necesitás activar JavaScript. También podés{' '}
          <a href="/#contacto">consultanos</a> por las propiedades disponibles.
        </p>
      </noscript>

      <div class="alquileres-note reveal" data-rentals-note hidden>
        <p class="alquileres-note-title">¿Buscás alquiler?</p>
        <p class="alquileres-note-text">
          Contamos con <span data-rentals-count></span> propiedades en alquiler disponibles actualmente. Contactanos
          para conocer los detalles.
        </p>
        <a href="/#contacto" class="btn btn-gold">Consultar alquileres</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Estilos que el sitio anterior tenía en línea. */
  .alquileres-note {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    text-align: center;
  }
  .alquileres-note-title {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  .alquileres-note-text {
    font-size: 0.9375rem;
    color: var(--ink-mute);
    margin-bottom: 1.25rem;
  }
</style>

<script>
  import { fetchProperties, localitiesOf, type Property } from '../../lib/properties';
  import { cardHtml } from '../../lib/properties/render';
  import { initFilters } from '../../scripts/filters';
  import { handleCardImages } from '../../scripts/images';
  import { enhance } from '../../scripts/site';

  const grid = document.querySelector<HTMLElement>('[data-props-grid]')!;
  const status = document.querySelector<HTMLElement>('[data-props-status]')!;
  const zona = document.querySelector<HTMLSelectElement>('#filter-zona');
  const note = document.querySelector<HTMLElement>('[data-rentals-note]');
  const count = document.querySelector<HTMLElement>('.filter-count');

  function render(properties: Property[]) {
    // Las localidades van antes de initFilters, que toma la elegida de la URL.
    if (zona) {
      while (zona.options.length > 1) zona.remove(1);
      for (const l of localitiesOf(properties)) zona.add(new Option(l.name, l.id));
    }
    grid.hidden = false;
    grid.innerHTML = properties.map((p, i) => cardHtml(p, true, i < 3)).join('');
    status.hidden = properties.length > 0;
    if (properties.length === 0) {
      status.innerHTML =
        'Estamos actualizando nuestra cartera. <a href="/#contacto">Consultanos</a> por las propiedades disponibles.';
    }
    const rentals = properties.filter((p) => p.operation === 'alquiler').length;
    if (note && rentals > 0) {
      note.querySelector('[data-rentals-count]')!.textContent = String(rentals);
      note.hidden = false;
    }
    handleCardImages(grid);
    initFilters();
    enhance(grid);
  }

  function showError() {
    grid.hidden = true;
    grid.innerHTML = '';
    status.hidden = false;
    status.innerHTML =
      'No pudimos cargar las propiedades. <button type="button" class="link-button" data-retry>Reintentar</button> o <a href="/#contacto">consultanos</a>.';
    status.querySelector('[data-retry]')?.addEventListener('click', () => location.reload());
    if (count) count.textContent = '—';
  }

  fetchProperties().then(render, (error) => {
    console.error('[propiedades] no se pudo cargar el listado', error);
    showError();
  });
</script>
