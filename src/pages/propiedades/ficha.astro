---
import Layout from '../../layouts/Layout.astro';

// Una sola página estática para todas las fichas: /propiedades/ficha?id=<uuid>.
// El navegador pide la propiedad a property-service y arma el contenido.
---

<Layout
  title="Propiedad | Rizzo Propiedades"
  description="Ficha de la propiedad en Rizzo Propiedades, Lanús."
  active="propiedades"
  noindex
>
  <div data-prop-detail>
    <section class="prop-detail-body">
      <div class="container">
        <p class="props-empty" data-prop-status>Cargando propiedad…</p>
        <noscript>
          <p class="props-empty">
            Para ver esta propiedad necesitás activar JavaScript. También podés{' '}
            <a href="/propiedades">ver todas las propiedades</a>.
          </p>
        </noscript>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  /* Estilos que el sitio anterior tenía en línea. Globales porque el contenido se arma con JS. */
  .pd-hero-tipo {
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pd-map-title {
    margin-top: 2.5rem;
  }
</style>

<script>
  import { fetchProperty, type Property } from '../../lib/properties';
  import { detailHtml, detailTitle } from '../../lib/properties/render';
  import { initGallery } from '../../scripts/gallery';
  import { handleDetailImages } from '../../scripts/images';

  const root = document.querySelector<HTMLElement>('[data-prop-detail]')!;
  const status = root.querySelector<HTMLElement>('[data-prop-status]')!;
  const id = new URLSearchParams(location.search).get('id');

  function showMessage(html: string) {
    status.innerHTML = html;
  }

  function setMeta(selector: string, value: string) {
    document.querySelector(selector)?.setAttribute('content', value);
  }

  function absoluteUrl(url: string): string {
    try {
      return new URL(url, location.origin).href;
    } catch {
      return url;
    }
  }

  function setPageTitle(title: string) {
    document.title = title;
    setMeta('meta[property="og:title"]', title);
  }

  function setSocialData(p: Property) {
    const title = `${detailTitle(p)} | Rizzo Propiedades`;
    const description =
      p.description.replace(/\s+/g, ' ').trim().slice(0, 160) || detailTitle(p);

    setPageTitle(title);
    setMeta('meta[name="description"]', description);
    setMeta('meta[property="og:description"]', description);
    setMeta('meta[property="og:url"]', location.href);
    if (p.photos[0]) setMeta('meta[property="og:image"]', absoluteUrl(p.photos[0]));
  }

  if (!id) {
    location.replace('/propiedades');
  } else {
    fetchProperty(id).then(
      (p) => {
        if (!p) {
          const title = 'Propiedad no encontrada | Rizzo Propiedades';
          setPageTitle(title);
          showMessage(
            'Esta propiedad ya no está disponible. <a href="/propiedades">Ver todas las propiedades</a>.',
          );
          return;
        }
        // Si se entró con el número de Hammer (?id=1469), la URL queda con el id definitivo.
        if (id !== p.id) history.replaceState(null, '', `?id=${encodeURIComponent(p.id)}`);
        setSocialData(p);
        root.innerHTML = detailHtml(p);
        const gallery = root.querySelector<HTMLElement>('[data-gallery]');
        const refreshGallery = gallery ? initGallery(gallery) : () => {};
        handleDetailImages(root, refreshGallery);
      },
      (error) => {
        console.error('[propiedades] no se pudo cargar la ficha', error);
        showMessage(
          'No pudimos cargar la propiedad. Probá de nuevo en un momento o <a href="/#contacto">consultanos</a>.',
        );
      },
    );
  }
</script>
