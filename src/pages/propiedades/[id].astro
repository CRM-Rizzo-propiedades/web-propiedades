---
import Layout from '../../layouts/Layout.astro';
import { whatsappUrl } from '../../config/site';
import {
  detailSpecs,
  formatAddress,
  formatExpenses,
  formatPrice,
  getProperties,
  OPERATION_LABEL,
  TYPE_LABEL,
  whatsappText,
  type Property,
} from '../../lib/properties';

// Por ahora el sitio es estático: una página por propiedad al hacer el build. Con el
// backend, esta ruta pasa a renderizarse en el servidor (adapter de Netlify).
export async function getStaticPaths() {
  const properties = await getProperties();
  return properties.map((property) => ({ params: { id: property.id }, props: { property } }));
}

const { property: p } = Astro.props as { property: Property };
const tipo = TYPE_LABEL[p.type];
const op = OPERATION_LABEL[p.operation];
const address = formatAddress(p);
const title = `${tipo}${address ? ` en ${address}` : ''}`;
const price = formatPrice(p) ?? 'Consultar precio';
const expenses = formatExpenses(p);
const specs = detailSpecs(p);
const paragraphs = p.description.split(/\n+/).map((s) => s.trim()).filter(Boolean);
const map = p.location
  ? (() => {
      const { lat, lng } = p.location;
      const d = 0.004;
      return `https://www.openstreetmap.org/export/embed.html?bbox=${lng - d},${lat - d},${lng + d},${lat + d}&layer=mapnik&marker=${lat},${lng}`;
    })()
  : null;
---

<Layout title={`${title} | Rizzo Propiedades`} description={p.title} active="propiedades" preloadImage={p.photos[0]}>
  <div class="prop-detail-hero" role="img" aria-label="Imagen de la propiedad">
    {
      p.photos[0] ? (
        <img class="prop-detail-hero-img" src={p.photos[0]} alt="Imagen principal de la propiedad" loading="eager" />
      ) : (
        <div class="prop-detail-hero-ph" />
      )
    }
    <div class="prop-detail-hero-overlay" aria-hidden="true"></div>
    <a href="/propiedades" class="prop-detail-hero-back" aria-label="Volver a propiedades">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
      Volver
    </a>
    <div class="prop-detail-hero-content">
      <div class="prop-detail-op-row">
        <span class:list={['prop-badge', `prop-badge--${p.operation}`]}>{op}</span>
        <span class="prop-tipo pd-hero-tipo">{tipo}</span>
      </div>
      <h1 class="prop-detail-title">{title}</h1>
      {
        address && (
          <p class="prop-detail-loc-hero">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
            <span>{address}</span>
          </p>
        )
      }
    </div>
  </div>

  <section class="prop-detail-body">
    <div class="container">
      <div class="prop-detail-grid">
        <div>
          {
            p.photos.length > 0 && (
              <div class="prop-detail-gallery" aria-label="Galería de fotos" data-gallery>
                <div class="pd-gal-inner">
                  <div class="pd-gal-track" role="list">
                    {p.photos.map((url, i) => (
                      <div class:list={['pd-gal-item', { 'is-active': i === 0 }]} role="listitem">
                        <div class="pd-gal-bg" style={`background-image:url(${JSON.stringify(url)})`} />
                        <img src={url} alt={`Foto ${i + 1} de la propiedad`} loading={i === 0 ? 'eager' : 'lazy'} class="pd-gal-img" />
                      </div>
                    ))}
                  </div>
                  {p.photos.length > 1 && (
                    <>
                      <button type="button" class="pd-gal-btn pd-gal-btn--prev" aria-label="Foto anterior" data-gallery-prev>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M15 18l-6-6 6-6" /></svg>
                      </button>
                      <button type="button" class="pd-gal-btn pd-gal-btn--next" aria-label="Siguiente foto" data-gallery-next>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path d="M9 18l6-6-6-6" /></svg>
                      </button>
                      <div class="pd-gal-ctrl-row">
                        <span class="pd-gal-counter" aria-live="polite" data-gallery-counter>1 / {p.photos.length}</span>
                      </div>
                    </>
                  )}
                </div>
              </div>
            )
          }

          {
            paragraphs.length > 0 && (
              <>
                <h2 class="prop-detail-desc-title">Descripción</h2>
                <div class="prop-detail-desc">
                  {paragraphs.map((text) => <p>{text}</p>)}
                </div>
              </>
            )
          }

          {
            map && (
              <>
                <h2 class="prop-detail-desc-title pd-map-title">Ubicación</h2>
                <div class="prop-detail-map" aria-label="Mapa de ubicación">
                  <iframe src={map} title="Ubicación de la propiedad" loading="lazy" allowfullscreen class="pd-map-iframe" />
                </div>
              </>
            )
          }
        </div>

        <aside class="prop-detail-sidebar" aria-label="Información y contacto">
          <p class="prop-detail-sidebar-tipo">{tipo}</p>
          <p class="prop-detail-sidebar-op">Operación: {op}</p>
          <p class="prop-detail-price">{price}</p>
          {expenses && <p class="prop-detail-expensas">{expenses}</p>}
          {
            specs.length > 0 && (
              <div class="prop-detail-specs-grid">
                {specs.map((s) => (
                  <div class="pd-spec-chip">
                    <span class="pd-spec-icon" aria-hidden="true">{s.icon}</span>
                    <span class="pd-spec-label">{s.label}</span>
                    <span class="pd-spec-val">{s.value}</span>
                  </div>
                ))}
              </div>
            )
          }
          <div class="prop-detail-divider" aria-hidden="true"></div>
          <a href={whatsappUrl(whatsappText(p))} class="btn btn-gold btn-full prop-detail-cta" target="_blank" rel="noopener">
            Consultar por WhatsApp
          </a>
          <a href="/#contacto" class="btn btn-outline-dark btn-full prop-detail-cta">Enviar consulta</a>
          <a href="/propiedades" class="prop-detail-back-link">← Ver todas las propiedades</a>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Estilos que el sitio anterior tenía en línea. */
  .pd-hero-tipo {
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pd-map-title {
    margin-top: 2.5rem;
  }
</style>

<script>
  import { initGallery } from '../../scripts/gallery';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>
