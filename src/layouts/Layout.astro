---
import '../styles/global.css';
import FloatingButtons from '../components/FloatingButtons.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TasacionModal from '../components/TasacionModal.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Inicio: menú con anclas y barra transparente sobre el hero. */
  home?: boolean;
  active?: 'propiedades';
  noindex?: boolean;
  /** Imagen a precargar (la del hero). */
  preloadImage?: string;
}
const { title, description, home = false, active, noindex = false, preloadImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL('/img/hero.jpg', site.url).href} />
    <meta name="theme-color" content="#FFFFFF" />
    <noscript>
      <style>
        .prop-card--skeleton,
        [data-props-status],
        [data-featured-status],
        [data-prop-status],
        .filter-count {
          display: none !important;
        }
      </style>
    </noscript>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garant:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"
    />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <div class="cursor" aria-hidden="true">
      <div class="cursor-dot"></div>
      <div class="cursor-ring"></div>
    </div>

    <FloatingButtons />
    <Header home={home} active={active} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <TasacionModal />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
