---
import {
  cardSpecs,
  formatAddress,
  formatPrice,
  OPERATION_LABEL,
  propertyUrl,
  TYPE_LABEL,
  type Property,
} from '../lib/properties';

interface Props {
  property: Property;
  /** En el listado la tarjeta lleva los datos que usan los filtros. */
  filterable?: boolean;
}
const { property: p, filterable = false } = Astro.props;
const address = formatAddress(p);
const price = formatPrice(p);
const specs = cardSpecs(p);
const alt = `${TYPE_LABEL[p.type]}${address ? ` en ${address}` : ''}`;
const filterData = filterable
  ? {
      'data-prop-card': '',
      'data-op': p.operation,
      'data-tipo': p.type,
      'data-ambientes': p.rooms ?? 0,
      'data-banios': p.bathrooms ?? 0,
      'data-cochera': p.garage ? 1 : 0,
      'data-credito': p.creditEligible ? 1 : 0,
      'data-valor': p.price?.amount ?? 0,
      'data-zona': p.locality?.id ?? '',
    }
  : {};
---

<article class="prop-card reveal" data-tilt {...filterData}>
  <a href={propertyUrl(p)} class="prop-card-link" aria-label={`Ver ficha de ${p.title}`}>
    <div class="prop-card-img-wrap">
      {
        p.photos[0] ? (
          <img src={p.photos[0]} alt={alt} loading="lazy" decoding="async" class="prop-card-img" />
        ) : (
          <div class="prop-card-img prop-card-img--ph" aria-hidden="true" />
        )
      }
      <span class="prop-badge">{OPERATION_LABEL[p.operation]}</span>
    </div>
    <div class="prop-card-body">
      <span class="prop-tipo">{TYPE_LABEL[p.type]}</span>
      <h3 class="prop-title">{p.title}</h3>
      <p class="prop-loc">
        <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        {address}
      </p>
      <p class="prop-price">{price ?? 'Consultar precio'}</p>
      {p.operation === 'alquiler' && p.expenses ? <p class="prop-expensas">Expensas: ARS {p.expenses.toLocaleString('es-AR')}</p> : null}
      {specs && <p class="prop-specs">{specs}</p>}
    </div>
  </a>
</article>
